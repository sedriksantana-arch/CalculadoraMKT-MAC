{
  "name": "mkt-calculadora",
  "productName": "Calculadora MKT+",
  "version": "1.0.0",
  "description": "Calculadora de precificação delivery - Agência MKT+",
  "main": "main.js",
  "author": {
    "name": "Sedrik O Santana"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "br.agenciamkt.calculadora",
    "files": [
      "*.html",
      "*.css",
      "*.js",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.business"
    },
    "copyright": "© 2026 Sedrik O Santana · Agência MKT+"
  }
}